# Copy this file to .env and fill in real values before enabling live trading.
# NEVER commit the real .env file - it is already listed in .gitignore.

# --- Hyperliquid credentials (only needed for live trading, unused in paper mode) ---
HYPERLIQUID_WALLET_ADDRESS=
HYPERLIQUID_PRIVATE_KEY=
HL_NETWORK=mainnet

# --- Trading mode ---
# paper = simulated fills using real market data, no funds at risk (default, recommended)
# live  = places real orders with real money - requires code changes and explicit intent
TRADING_MODE=paper

# --- Market ---
SYMBOLS=BTC,ETH,SOL
TIMEFRAME=1h
CYCLE_SECONDS=900

# --- Population / evolution ---
POPULATION_CAP=500
ACTIVE_TRADER_COUNT=50
MIN_POPULATION_FLOOR=50
CHILDREN_PER_WIN=2
WIN_STREAK_SHARE_THRESHOLD=8
INITIAL_POPULATION=40
STARTING_PAPER_BALANCE=1000

# --- Ollama reasoning fallback ---
OLLAMA_ENABLED=true
OLLAMA_MODEL=qwen2.5:7b

# --- Storage ---
DB_PATH=trading_agents.db
