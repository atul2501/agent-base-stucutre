# Copy this file to .env and adjust. NEVER commit the real .env - it is
# already listed in .gitignore.

# --- Market: exactly ONE token at a time by design ---
# Changing this to a different asset requires running `python3 main.py --reset`
# (wipes all agents/history) - a population's strategies are only ever tuned
# to the token they trained on. See README "one token at a time".
TOKEN=SOL
TIMEFRAME=1h
CYCLE_SECONDS=900
# A slower timeframe checked alongside the primary one, live-only (see
# README "Higher-timeframe trend filter") - trading with the bigger trend.
HIGHER_TIMEFRAME=1h

# --- Trading mode: the one switch that matters ---
# paper (default) -> always simulated, never touches the real exchange, no
#   matter what network is set below.
# live -> places real orders on whichever network you're pointed at.
TRADING_MODE=paper

# Which Hyperliquid environment to use (for price data always, and for real
# orders when TRADING_MODE=live).
# testnet -> if live, real orders with FAKE testnet funds - a safe way to
#   test the live order-placement code before ever touching real money.
# mainnet -> if live, REAL MONEY. Also requires LIVE_TRADING_CONFIRMED below
#   to be set to the exact phrase - this extra gate only applies to mainnet.
HL_NETWORK=testnet
LIVE_TRADING_CONFIRMED=

# Hyperliquid wallet - only needed once TRADING_MODE=live.
HYPERLIQUID_WALLET_ADDRESS=
HYPERLIQUID_PRIVATE_KEY=

# --- Live trading hard risk limits (only enforced once live is armed) ---
# Total real dollars the system will ever have deployed across all live
# positions at once. The code refuses to exceed this regardless of what any
# agent's own strategy calculates. Start small.
LIVE_MAX_TOTAL_NOTIONAL_USD=100
# How many of the top-ranked active traders are allowed to contribute to the
# real (aggregate - see README) live position.
LIVE_ACTIVE_TRADER_COUNT=20
LIVE_MAX_LEVERAGE=5
# Circuit breaker: flattens the real position and PAUSES live trading (until
# explicitly cleared with `python3 main.py --clear-live-breaker`) if either
# trips - the one safeguard that protects real money, not just statistics.
LIVE_CIRCUIT_BREAKER_ENABLED=true
LIVE_MAX_DRAWDOWN_PCT=20.0
LIVE_STALE_PRICE_CYCLES=5

# --- Population / evolution ---
POPULATION_CAP=500
ACTIVE_TRADER_COUNT=50
MIN_POPULATION_FLOOR=50
CHILDREN_PER_WIN=2
WIN_STREAK_SHARE_THRESHOLD=8
INITIAL_POPULATION=40
STARTING_PAPER_BALANCE=1000
# Chance a win's child comes from crossing two successful agents instead of
# pure self-mutation (see README "Position sizing, fitness, and population
# diversity").
CROSSOVER_PROBABILITY=0.3
# Reserved active-trader slots for the newest untested agents and for
# under-represented strategy families, respectively - both guard against
# one lineage/style monopolizing every trading slot. See README.
GUARANTEED_NEWCOMER_SLOTS=5
DIVERSITY_FLOOR_ENABLED=true

# --- Backtest pre-screening (see README) ---
# New agents are born from the best of several candidate genomes, chosen by
# replaying each against real historical data - not purely random/mutated.
# Doesn't change live do-or-die trading at all, only what genome an agent
# starts with. Disable to go back to pure random/mutation.
BACKTEST_ENABLED=true
# Hyperliquid caps a single candle request at ~5000 bars (~17 days of 5m
# data) - stay safely under that.
BACKTEST_LOOKBACK_HOURS=360
BACKTEST_CANDIDATES=5
# Second, coarser-timeframe backtest window (split into segments) used only
# to check a new candidate genome isn't just tuned to whatever regime the
# recent window above happened to be - see README "all-regime robustness".
BACKTEST_REGIME_TIMEFRAME=1h
BACKTEST_REGIME_LOOKBACK_HOURS=4000
BACKTEST_REGIME_SEGMENTS=3

# --- Revalidation: periodic re-backtest of already-proven top agents
# against the newest data, to flag (dashboard only) a veteran that's
# drifted out of sync with the current market instead of silently trusting
# a genome that proved itself once, possibly a while ago. ---
REVALIDATION_ENABLED=true
REVALIDATION_INTERVAL_CYCLES=20
REVALIDATION_AGENT_LIMIT=50
REVALIDATION_DRIFT_THRESHOLD=-5.0
BACKTEST_REFRESH_INTERVAL_CYCLES=20

# --- Council vote: ensemble second opinion for ambiguous signals, tried
# before ever calling Ollama (see README "council vote"). ---
COUNCIL_ENABLED=true
COUNCIL_SIZE=10
COUNCIL_QUORUM_PCT=0.6
COUNCIL_MIN_ACTIVE_VOTERS=3

# --- Ollama reasoning fallback (cloud API by default, no local model needed) ---
OLLAMA_ENABLED=true
OLLAMA_HOST=https://ollama.com
# Get a free key at https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:20b

# --- Storage ---
DB_PATH=db/trading_agents.db

# --- Dashboard ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
